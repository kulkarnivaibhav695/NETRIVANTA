# Required in production: use a unique persistent random value of at least 32 characters.
NETRIVANTA_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-characters
# Bootstrap the first administrator on an empty database. Keep this secret.
NETRIVANTA_ADMIN_NAME=NETRIVANTA Administrator
NETRIVANTA_ADMIN_EMAIL=admin@example.com
NETRIVANTA_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
# Set true only when serving the site over HTTPS.
COOKIE_SECURE=false
NETRIVANTA_DATABASE=./netrivanta.db

# Optional: set this to a Neon PostgreSQL connection string for hosted deployments.
# When set, it takes precedence over NETRIVANTA_DATABASE.
# NETRIVANTA_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
